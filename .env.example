# Django
SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=False

# Database engine: sqlite3 (dev) or postgresql (production)
DB_ENGINE=sqlite3

# PostgreSQL connection (only used when DB_ENGINE=postgresql)
DB_NAME=portfolio_django
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=oracle-postgres-host-or-ip
DB_PORT=5432